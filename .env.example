# AI Multichannel System - Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ============================================
# Application Configuration
# ============================================
APP_NAME=AI Multichannel System
APP_VERSION=1.0.0
APP_ENV=development  # development, staging, production
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Public URL used for generated media/webhook links
PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
HTTP_PORT=80

# CORS Configuration (comma-separated list of origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOW_HEADERS=*

# ============================================
# Security Configuration
# ============================================
# Generate a secure secret key with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# Database Configuration (PostgreSQL)
# ============================================
# Host apps use localhost; containers override this to reach the db service.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_multichannel
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_multichannel

# ============================================
# Redis Configuration
# ============================================
REDIS_URL=redis://localhost:6379/0

# ============================================
# AI Model Configuration (OpenRouter)
# ============================================
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_AI_MODEL=mistralai/mistral-7b-instruct

# ============================================
# Object Storage (S3-compatible)
# ============================================
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
S3_PUBLIC_URL_BASE=
S3_PREFIX=uploads

# ============================================
# SMS & Voice Configuration (Twilio)
# ============================================
# Get your credentials from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1234567890  # Your Twilio phone number in E.164 format

# ============================================
# Text-to-Speech Configuration (ElevenLabs)
# ============================================
# Get your API key from: https://elevenlabs.io/
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM  # Rachel voice (default)

# ============================================
# Speech-to-Text Configuration (AssemblyAI - Optional)
# ============================================
ASSEMBLYAI_API_KEY=

# ============================================
# File Upload Configuration
# ============================================
MAX_FILE_SIZE_MB=100
ALLOWED_FILE_TYPES=.mp3,.wav,.ogg,.png,.jpg,.jpeg,.pdf,.txt

# ============================================
# Rate Limiting Configuration
# ============================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60  # seconds
